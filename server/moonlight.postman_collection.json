{
  "info": {
    "name": "Moonlight Server",
    "_postman_id": "moonlight-server-v1",
    "description": "API collection for Project Moonlight server. All /api/* endpoints require a Firebase ID token.\n\n**Setup:**\n1. Set the `baseUrl` variable to your server (default: http://localhost:3001).\n2. Set the `idToken` variable to a valid Firebase ID token.\n3. Set `userId` to the UID that matches the token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "idToken",
      "value": "<paste-firebase-id-token-here>",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "<paste-firebase-uid-here>",
      "type": "string"
    },
    {
      "key": "reflectionId",
      "value": "",
      "type": "string",
      "description": "Populated automatically by 'Create Reflection' or 'Ask Question (new session)' tests."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "No auth required. Returns {\"status\":\"ok\"} when the server is running."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reflections",
      "item": [
        {
          "name": "Get Reflections",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reflections?user_id={{userId}}&counts=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reflections"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{userId}}"
                },
                {
                  "key": "counts",
                  "value": "10",
                  "description": "Number of results per page (1–100, default 10)"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "Opaque cursor from previous response pagination.cursor. Leave empty for first page.",
                  "disabled": true
                }
              ]
            },
            "description": "Returns a paginated list of the authenticated user's reflections.\n\nResponse shape:\n```json\n{\n  \"pagination\": { \"size\": 10, \"cursor\": \"<next-cursor-or-empty>\" },\n  \"entries\": [\n    { \"id\": \"\", \"label\": \"\", \"owner_id\": \"\", \"trace_ids\": [] }\n  ]\n}\n```"
          },
          "response": []
        },
        {
          "name": "Create Reflection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('reflectionId', json.id);",
                  "  console.log('reflectionId set to', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"My first reflection\",\n  \"traces\": [\n    {\n      \"q\": \"What is spaced repetition?\",\n      \"a\": \"A learning technique that uses increasing intervals between reviews.\",\n      \"created_time\": 1743033600000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/reflection",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reflection"]
            },
            "description": "Creates a new reflection with optional initial traces. The response `id` is saved to the `reflectionId` collection variable automatically.\n\nRequest body:\n- `label` (required, non-empty string)\n- `traces` (optional array of `{ q, a, created_time }`) \n\nResponse: `{ \"id\": \"<new-reflection-id>\" }` (HTTP 201)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Traces",
      "item": [
        {
          "name": "Get Traces",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/traces?user_id={{userId}}&reflection_id={{reflectionId}}&counts=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "traces"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{userId}}"
                },
                {
                  "key": "reflection_id",
                  "value": "{{reflectionId}}",
                  "description": "ID of the reflection whose traces you want to fetch"
                },
                {
                  "key": "counts",
                  "value": "10",
                  "description": "Number of results per page (1–100, default 10)"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "Opaque cursor from previous response. Leave empty for first page.",
                  "disabled": true
                }
              ]
            },
            "description": "Returns paginated traces (Q&A pairs) for a given reflection.\nReturns 404 if the reflection doesn't exist or belongs to another user.\n\nResponse shape:\n```json\n{\n  \"pagination\": { \"size\": 10, \"cursor\": \"\" },\n  \"entries\": [\n    { \"id\": \"\", \"created_time\": 0, \"q\": \"\", \"a\": \"\" }\n  ]\n}\n```"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Answer (AI)",
      "item": [
        {
          "name": "Ask Question (new session)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.reflection_id) {",
                  "  pm.collectionVariables.set('reflectionId', json.reflection_id);",
                  "  console.log('reflectionId set to', json.reflection_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/answer?user_id={{userId}}&question=What is spaced repetition?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "answer"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{userId}}"
                },
                {
                  "key": "question",
                  "value": "What is spaced repetition?",
                  "description": "The question to ask the AI"
                },
                {
                  "key": "reflection_id",
                  "value": "",
                  "description": "Omit to start a new reflection session. The new reflection_id is returned in the response.",
                  "disabled": true
                }
              ]
            },
            "description": "Asks a question with no existing session. The server auto-creates a new reflection and returns its ID, which is saved to `reflectionId` automatically.\n\nResponse shape:\n```json\n{\n  \"reflection_id\": \"<new-or-existing-id>\",\n  \"question\": \"...\",\n  \"answer\": \"...\"\n}\n```"
          },
          "response": []
        },
        {
          "name": "Ask Follow-up Question (existing session)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/answer?user_id={{userId}}&reflection_id={{reflectionId}}&question=Can you give me a practical example?",
              "host": ["{{baseUrl}}"],
              "path": ["api", "answer"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{userId}}"
                },
                {
                  "key": "reflection_id",
                  "value": "{{reflectionId}}",
                  "description": "Chain follow-up questions to the same reflection session"
                },
                {
                  "key": "question",
                  "value": "Can you give me a practical example?"
                }
              ]
            },
            "description": "Follow-up question linked to an existing reflection session (uses `reflectionId` variable set by a previous request). Each call appends a new trace to the reflection."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Missing Auth Token (expect 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reflections?user_id={{userId}}&counts=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reflections"],
              "query": [
                { "key": "user_id", "value": "{{userId}}" },
                { "key": "counts", "value": "10" }
              ]
            },
            "description": "No Authorization header — should return HTTP 401."
          },
          "response": []
        },
        {
          "name": "Mismatched user_id (expect 403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reflections?user_id=some-other-uid&counts=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reflections"],
              "query": [
                {
                  "key": "user_id",
                  "value": "some-other-uid",
                  "description": "Intentionally wrong — token UID won't match this"
                },
                { "key": "counts", "value": "10" }
              ]
            },
            "description": "Valid token but `user_id` query param doesn't match the token UID — should return HTTP 403."
          },
          "response": []
        },
        {
          "name": "Non-existent Reflection Traces (expect 404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/traces?user_id={{userId}}&reflection_id=nonexistent-id&counts=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "traces"],
              "query": [
                { "key": "user_id", "value": "{{userId}}" },
                { "key": "reflection_id", "value": "nonexistent-id" },
                { "key": "counts", "value": "10" }
              ]
            },
            "description": "Reflection ID doesn't exist — should return HTTP 404."
          },
          "response": []
        }
      ]
    }
  ]
}
