# Firebase project
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase service account key JSON (base64-encoded).
# To encode: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=your-base64-encoded-service-account-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Server
PORT=3001

# Set to "true" to connect to Firebase Emulator Suite instead of production
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
